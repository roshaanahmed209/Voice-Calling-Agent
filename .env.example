# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# The public https URL where this service is reachable. Vapi calls it, so it
# must be reachable from the internet — a Railway/Render URL, or an ngrok
# tunnel while developing locally. No trailing slash.
PUBLIC_BASE_URL=https://your-app.up.railway.app

# --- Database --------------------------------------------------------------
# Local default (no setup needed):
DATABASE_URL=sqlite:///./data/patients.db
# Postgres instead — Railway injects this automatically when you attach the
# Postgres plugin, so leave it unset there:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Vapi ------------------------------------------------------------------
# Any long random string. Put the SAME value in the Vapi assistant's
# "Server URL Secret" field. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_SECRET=replace-with-a-long-random-string

# Only needed if you run scripts/provision_vapi.py instead of clicking through
# the Vapi dashboard. Find the key under Vapi > Settings > API Keys (private).
VAPI_API_KEY=
# Vapi > Phone Numbers > click your number > copy the ID from the URL.
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# --- Dashboard login -------------------------------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-string
