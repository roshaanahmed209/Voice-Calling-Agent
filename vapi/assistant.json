{
  "_comment": [
    "Vapi assistant definition. Two ways to use this file:",
    "  1. Run `python scripts/provision_vapi.py` to create/update the assistant via API.",
    "  2. Copy the pieces manually into the Vapi dashboard.",
    "Replace __PUBLIC_BASE_URL__ and __VAPI_SECRET__ with your real values, or let",
    "the provisioning script substitute them from your .env automatically.",
    "The systemPrompt below is kept in sync with prompts/system_prompt.md."
  ],

  "name": "Northgate Intake - Robin",
  "firstMessage": "Northgate Family Health, this is Robin. Are you calling to register as a new patient?",
  "firstMessageMode": "assistant-speaks-first",

  "model": {
    "provider": "openai",
    "model": "gpt-4o",
    "temperature": 0.4,
    "messages": [
      {
        "role": "system",
        "content": "PASTE_SYSTEM_PROMPT_HERE — the provisioning script fills this from prompts/system_prompt.md"
      }
    ],
    "tools": [
      {
        "type": "function",
        "async": false,
        "server": {
          "url": "__PUBLIC_BASE_URL__/vapi/webhook",
          "secret": "__VAPI_SECRET__"
        },
        "function": {
          "name": "lookup_patient",
          "description": "Check whether a patient record already exists for a phone number. Call this once at the start of the call, before collecting any details, using the number the caller is calling from.",
          "parameters": {
            "type": "object",
            "properties": {
              "phone_number": {
                "type": "string",
                "description": "10-digit US phone number, digits only. Omit to use the caller's inbound number."
              }
            },
            "required": []
          }
        }
      },
      {
        "type": "function",
        "async": false,
        "server": {
          "url": "__PUBLIC_BASE_URL__/vapi/webhook",
          "secret": "__VAPI_SECRET__"
        },
        "function": {
          "name": "create_patient",
          "description": "Save a new patient record. Call this only after the caller has confirmed the read-back of their information. Omit optional fields entirely if the caller did not provide them.",
          "parameters": {
            "type": "object",
            "properties": {
              "first_name": { "type": "string", "description": "Given name. Join spelled-out letters into one word." },
              "last_name": { "type": "string", "description": "Family name. Join spelled-out letters into one word." },
              "date_of_birth": { "type": "string", "description": "MM/DD/YYYY. Must not be in the future." },
              "sex": {
                "type": "string",
                "enum": ["Male", "Female", "Other", "Decline to Answer"],
                "description": "Exactly one of the listed values."
              },
              "phone_number": { "type": "string", "description": "10 digits, no punctuation." },
              "email": { "type": "string", "description": "Optional email address." },
              "address_line_1": { "type": "string", "description": "Street number and name." },
              "address_line_2": { "type": "string", "description": "Optional apartment, suite or unit." },
              "city": { "type": "string" },
              "state": { "type": "string", "description": "Two-letter US state abbreviation, e.g. CA." },
              "zip_code": { "type": "string", "description": "5 digits, or ZIP+4 as 12345-6789." },
              "insurance_provider": { "type": "string", "description": "Optional insurance company name." },
              "insurance_member_id": { "type": "string", "description": "Optional alphanumeric member ID." },
              "preferred_language": { "type": "string", "description": "Defaults to English." },
              "emergency_contact_name": { "type": "string", "description": "Optional full name." },
              "emergency_contact_phone": { "type": "string", "description": "Optional 10 digits, no punctuation." },
              "next_appointment": { "type": "string", "description": "Optional spoken appointment slot if they booked one during the call." }
            },
            "required": [
              "first_name", "last_name", "date_of_birth", "sex",
              "phone_number", "address_line_1", "city", "state", "zip_code"
            ]
          }
        }
      },
      {
        "type": "function",
        "async": false,
        "server": {
          "url": "__PUBLIC_BASE_URL__/vapi/webhook",
          "secret": "__VAPI_SECRET__"
        },
        "function": {
          "name": "update_patient",
          "description": "Update an existing patient record. Use when lookup_patient found an existing record and the caller agreed to update it. Send only the fields that are changing.",
          "parameters": {
            "type": "object",
            "properties": {
              "patient_id": { "type": "string", "description": "The patient_id returned by lookup_patient." },
              "first_name": { "type": "string" },
              "last_name": { "type": "string" },
              "date_of_birth": { "type": "string", "description": "MM/DD/YYYY" },
              "sex": { "type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"] },
              "phone_number": { "type": "string" },
              "email": { "type": "string" },
              "address_line_1": { "type": "string" },
              "address_line_2": { "type": "string" },
              "city": { "type": "string" },
              "state": { "type": "string" },
              "zip_code": { "type": "string" },
              "insurance_provider": { "type": "string" },
              "insurance_member_id": { "type": "string" },
              "preferred_language": { "type": "string" },
              "emergency_contact_name": { "type": "string" },
              "emergency_contact_phone": { "type": "string" },
              "next_appointment": { "type": "string", "description": "Spoken slot the caller booked, e.g. Tuesday at 10:00 AM." }
            },
            "required": ["patient_id"]
          }
        }
      }
    ]
  },

  "voice": {
    "provider": "11labs",
    "voiceId": "burt",
    "stability": 0.5,
    "similarityBoost": 0.75
  },

  "transcriber": {
    "provider": "deepgram",
    "model": "nova-2",
    "language": "en-US",
    "smartFormat": true
  },

  "server": {
    "url": "__PUBLIC_BASE_URL__/vapi/webhook",
    "secret": "__VAPI_SECRET__"
  },
  "serverMessages": ["tool-calls", "end-of-call-report", "status-update"],

  "silenceTimeoutSeconds": 20,
  "customerJoinTimeoutSeconds": 90,
  "maxDurationSeconds": 900,
  "endCallMessage": "Thanks for calling Northgate Family Health. Take care.",
  "endCallFunctionEnabled": true,
  "backgroundSound": "office"
}
